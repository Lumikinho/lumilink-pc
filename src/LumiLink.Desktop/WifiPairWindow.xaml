<Window x:Class="LumiLink.Desktop.WifiPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Espelhar via Wi-Fi" Height="320" Width="340">
  <StackPanel Margin="16">
    <TextBlock Text="No celular: Depuração sem fio → Parear com código." TextWrapping="Wrap"/>
    <TextBlock Text="IP:" Margin="0,8,0,0"/><TextBox x:Name="IpBox" Margin="0,2,0,8"/>
    <TextBlock Text="Porta de pareamento:"/><TextBox x:Name="PortBox" Margin="0,2,0,8"/>
    <TextBlock Text="Código:"/><TextBox x:Name="CodeBox" MaxLength="6" Margin="0,2,0,8"/>
    <Button Content="Parear e espelhar" Click="BtnGo_Click"/>
    <TextBlock x:Name="ErrLabel" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
</Window>
