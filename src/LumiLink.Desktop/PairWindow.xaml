<Window x:Class="LumiLink.Desktop.PairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parear novo dispositivo" Height="520" Width="360">
  <StackPanel Margin="16">
    <TextBlock Text="Escaneie o QR ou digite IP:porta + código (vale 2 min):" TextWrapping="Wrap"/>
    <Image x:Name="QrImage" Width="240" Height="240" Margin="0,8,0,0"/>
    <TextBlock x:Name="CodeLabel" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
    <TextBlock x:Name="AddrLabel" FontSize="14" Margin="0,4,0,0"/>
    <Button Content="Fechar" Click="BtnClose_Click" Margin="0,12,0,0"/>
  </StackPanel>
</Window>
