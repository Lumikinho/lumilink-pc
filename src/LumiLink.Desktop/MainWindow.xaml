<Window x:Class="LumiLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumiLink (nó P2P)" Height="640" Width="540">
  <StackPanel Margin="16" Orientation="Vertical">
    <TextBlock x:Name="StateLabel" FontSize="16" FontWeight="Bold" Text="Iniciando..."/>
    <TextBlock x:Name="SelfInfo" Opacity="0.7" Margin="0,2,0,0"/>
    <TextBlock x:Name="LogBox" Height="150" Background="#111" Foreground="#0f0"
               FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="Parear novo dispositivo" Click="BtnPair_Click" Margin="0,0,8,0"/>
      <Button Content="Conectar manualmente" Click="BtnManual_Click" Margin="0,0,8,0"/>
      <Button Content="Atualizar" Click="BtnRefresh_Click"/>
    </StackPanel>
    <TextBlock Text="Pareados:" FontWeight="Bold" Margin="0,8,0,4"/>
    <ListView x:Name="PeerList" Height="150" MouseDoubleClick="PeerList_DoubleClick">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Nome" DisplayMemberBinding="{Binding Name}" Width="150"/>
          <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding State}" Width="100"/>
          <GridViewColumn Header="Último contato" DisplayMemberBinding="{Binding LastSeen}" Width="150"/>
        </GridView>
      </ListView.View>
    </ListView>
    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
      <Button Content="Detalhes" Click="BtnDetail_Click" Margin="0,0,8,0"/>
      <Button Content="Esquecer" Click="BtnForget_Click" Margin="0,0,8,0"/>
      <Button Content="Meu perfil" Click="BtnProfile_Click"/>
    </StackPanel>
    <CheckBox x:Name="ChkAutostart" Content="Iniciar com o Windows" Margin="0,8,0,0"
              Checked="ChkAutostart_Changed" Unchecked="ChkAutostart_Changed"/>
    <TextBlock Text="Minimizar fecha para a bandeja. Duplo clique abre detalhes." Opacity="0.6" Margin="0,4,0,0"/>
  </StackPanel>
</Window>
