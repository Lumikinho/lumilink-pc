<Window x:Class="LumiLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LumiLink (PC)" Height="560" Width="460">
  <StackPanel Margin="16" Orientation="Vertical">
    <TextBlock x:Name="StateLabel" FontSize="16" FontWeight="Bold" Text="Desconectado"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
      <Image x:Name="PeerPhoto" Width="48" Height="48" Margin="0,0,8,0"/>
      <TextBlock x:Name="PeerName" FontSize="14" VerticalAlignment="Center" Text="Nenhum celular conectado"/>
    </StackPanel>
    <TextBlock x:Name="LogBox" Height="180" Background="#111" Foreground="#0f0"
               FontFamily="Consolas" TextWrapping="Wrap" />
    <Button x:Name="BtnPair" Content="Parear novo celular (mostrar QR)" Margin="0,8,0,0" Click="BtnPair_Click"/>
    <Image x:Name="QrImage" Width="220" Height="220" Margin="0,8,0,0"/>
    <TextBlock Text="Pareados:" FontWeight="Bold" Margin="0,8,0,4"/>
    <ListBox x:Name="PairList" Height="90"/>
    <StackPanel Orientation="Horizontal">
      <Button Content="Esquecer selecionado" Click="BtnForget_Click" Margin="0,4,8,0"/>
      <Button Content="Meu perfil" Click="BtnProfile_Click" Margin="0,4,0,0"/>
    </StackPanel>
    <CheckBox x:Name="ChkAutostart" Content="Iniciar com o Windows" Margin="0,8,0,0"
              Checked="ChkAutostart_Changed" Unchecked="ChkAutostart_Changed"/>
    <TextBlock Text="Minimizar fecha para a bandeja." Opacity="0.6" Margin="0,4,0,0"/>
  </StackPanel>
</Window>
